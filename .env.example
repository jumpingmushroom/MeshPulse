# Required. MQTT broker. The user needs subscribe on zigbee2mqtt/# only (the app never publishes).
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Zigbee2MQTT base topic.
Z2M_BASE_TOPIC=zigbee2mqtt

# SQLite file. Keep the default in Docker and mount /data as a volume.
DATABASE_PATH=/data/meshpulse.db

# URL users open in the browser, for example https://meshpulse.example.com.
# Used for login and for links in Discord messages. Must match exactly.
# If https, open MeshPulse only via that URL: http://host:3000 then fails login silently
# (the browser drops the Secure cookie).
# Leave empty to derive it from the request (plain http://host:3000).
PUBLIC_URL=

# Display time zone.
TZ=Europe/Oslo

# Optional. Generated into the data folder (secret.key) when empty; set it to keep the same key across data folders.
# If set, use at least 32 characters (openssl rand -base64 32).
# If your install already sets SECRET_KEY, keep it: clearing it generates a new key, logs everyone out, and the stored Discord, Apprise and UniFi secrets can no longer be decrypted.
SECRET_KEY=

# Optional: Uptime Kuma push URL, called every 60 s.
HEARTBEAT_URL=

# Optional. When empty, the first visit shows a page to create the admin account.
# If both are set, the account is created at startup if missing (sign-up is disabled).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Behind a reverse proxy (Traefik, Dokploy), uncomment these.
# PROTOCOL_HEADER=x-forwarded-proto  (already the default in the Docker image)
# HOST_HEADER=x-forwarded-host
# Without the next two, the login rate limiter sees every user as the proxy IP.
# Set them only behind a trusted proxy: otherwise a client can forge X-Forwarded-For. XFF_DEPTH = number of proxies.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
