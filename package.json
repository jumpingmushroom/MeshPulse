{
	"name": "meshpulse",
	"private": true,
	"version": "0.5.0-rc.3",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"capture": "node scripts/capture.ts",
		"replay": "NODE_OPTIONS=--max-old-space-size=4096 vitest run scripts/replay.test.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"better-auth": "^1.7.10",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"mqtt": "^5.16.1"
	}
}
