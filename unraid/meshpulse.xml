<?xml version="1.0"?>
<Container version="2">
  <Name>MeshPulse</Name>
  <Repository>meshpulse:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/jumpingmushroom/MeshPulse</Support>
  <Project>https://github.com/jumpingmushroom/MeshPulse</Project>
  <Overview>Passive, read-only Zigbee2MQTT health monitor. Watches MQTT traffic, raises a few actionable issues (offline devices, flapping, low batteries, bridge down) and notifies Discord. Needs availability, health and MQTT log output enabled in Zigbee2MQTT (see README).</Overview>
  <Category>HomeAutomation: Tools:System</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <Config Name="Web UI Port" Target="3000" Default="3000" Mode="tcp" Description="Web UI port" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/user/appdata/meshpulse" Mode="rw" Description="SQLite database" Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/meshpulse</Config>
  <Config Name="MQTT URL" Target="MQTT_URL" Default="mqtt://192.168.1.10:1883" Mode="" Description="Broker that Zigbee2MQTT publishes to" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="MQTT username" Target="MQTT_USERNAME" Default="" Mode="" Description="Read-only broker user (subscribe on zigbee2mqtt/#)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="MQTT password" Target="MQTT_PASSWORD" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Z2M base topic" Target="Z2M_BASE_TOPIC" Default="zigbee2mqtt" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">zigbee2mqtt</Config>
  <Config Name="Admin email" Target="ADMIN_EMAIL" Default="" Mode="" Description="Login created on first start" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Admin password" Target="ADMIN_PASSWORD" Default="" Mode="" Description="Used only on first start; at least 8 characters" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Secret key" Target="SECRET_KEY" Default="" Mode="" Description="At least 32 random characters (openssl rand -base64 32). Changing it logs everyone out and breaks the stored Discord webhook." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Time zone" Target="TZ" Default="Europe/Oslo" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Oslo</Config>
  <Config Name="Public URL" Target="PUBLIC_URL" Default="" Mode="" Description="Optional. URL used in Discord links. If https, open MeshPulse only via that URL." Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Heartbeat URL" Target="HEARTBEAT_URL" Default="" Mode="" Description="Optional dead-man's switch (Uptime Kuma push URL). Can also be set in Settings." Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
</Container>
